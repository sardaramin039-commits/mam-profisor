{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app"
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/app/**/*.ts",
    "src/services/**/*.ts",
    "src/helpers/**/*.ts",
    "src/prompts/**/*.ts",
    "src/utils/**/*.ts",
    "src/config/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/server/**",
    "src/routes/**",
    "src/db/**",
    "src/middleware/**",
    "src/lib/**"
  ]
}
