{
  "name": "academic-thesis-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "dev": "node --max-old-space-size=2048 node_modules/@angular/cli/bin/ng.js serve",
    "start": "node dist/app/server/server.mjs",
    "build": "node --max-old-space-size=4096 node_modules/@angular/cli/bin/ng.js build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "test": "ng test --watch=false",
    "integrity:audit": "node scripts/anti-hallucination-audit.mjs",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "line-limit": "node scripts/verify-file-line-limits.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^20.3.37",
    "@angular/common": "^20.3.37",
    "@angular/compiler": "^20.3.37",
    "@angular/core": "^20.3.37",
    "@angular/forms": "^20.3.37",
    "@angular/material": "^20.3.37",
    "@angular/platform-browser": "^20.3.37",
    "@angular/platform-browser-dynamic": "^20.3.37",
    "@angular/platform-server": "^20.3.37",
    "@angular/router": "^20.3.37",
    "@angular/ssr": "^20.3.37",
    "@google/genai": "^2.24.0",
    "@tailwindcss/postcss": "^4.0.0",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^4.22.3",
    "firebase": "^11.2.0",
    "firebase-admin": "^13.1.0",
    "motion": "^12.4.1",
    "pg": "^8.13.1",
    "postcss": "^8.5.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.3.0",
    "zod": "^4.5.4",
    "docx": "^9.7.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.37",
    "@angular-eslint/builder": "^20.1.1",
    "@angular-eslint/eslint-plugin": "^20.1.1",
    "@angular-eslint/template-parser": "^20.1.1",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.37",
    "@eslint/js": "^9.28.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "angular-eslint": "^20.1.1",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.28.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^5.0.2",
    "jsdom": "^30.1.1",
    "@angular/build": "^20.3.37"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.8",
  "description": "Kurdish-first academic research and thesis workspace."
}
