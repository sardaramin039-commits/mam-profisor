{
  "name": "academic-thesis-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "start": "node --max-old-space-size=3072 dist/app/server/server.mjs",
    "build": "node --max-old-space-size=3072 node_modules/@angular/cli/bin/ng.js build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "test": "ng test --watch=false",
    "integrity:audit": "node scripts/anti-hallucination-audit.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "line-limit": "node scripts/verify-file-line-limits.mjs",
    "release:check": "node scripts/release-readiness-check.mjs",
    "release:smoke": "node scripts/release-smoke-check.mjs",
    "db:migrate": "drizzle-kit migrate",
    "test:server": "vitest run src/server/routes/publication-submission-editorial.routes.spec.ts src/routes/agents.router.spec.ts src/services/academic-agents.service.spec.ts src/server/routes/rag.routes.spec.ts src/server/middleware/rbac.middleware.spec.ts src/server/middleware/security.middleware.spec.ts src/server/services/source-verification.service.security.spec.ts",
    "phase3:preserve": "node scripts/phase-3-preservation-gate.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^20.3.32",
    "@google/genai": "^2.24.0",
    "@tailwindcss/postcss": "^4.0.0",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "motion": "^12.4.1",
    "pg": "^8.13.1",
    "postcss": "^8.5.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.3.0",
    "zod": "^4.5.4",
    "docx": "^9.7.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular-eslint/builder": "^20.1.1",
    "@angular-eslint/eslint-plugin": "^20.1.1",
    "@angular-eslint/template-parser": "^20.1.1",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^9.28.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "angular-eslint": "^22.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.28.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^3.2.7",
    "jsdom": "^30.1.1",
    "@angular/build": "^20.3.37",
    "@playwright/test": "^1.64.0"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.9.0"
  },
  "description": "Kurdish-first academic research and thesis workspace.",
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "uuid": "11.1.1"
  }
}
