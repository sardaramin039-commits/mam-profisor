# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALLOW_DEV_PREVIEW: Set true ONLY for local development with NODE_ENV=development. Never enable in production.\nALLOW_DEV_PREVIEW="false"\n\n# YOU_API_KEY: Optional API Key for You.com Search & Grounding integration.
# Used to query live web, news, and academic papers to generate factual bibiographies.
YOU_API_KEY=""

# OPENALEX_API_KEY: Optional API Key for OpenAlex Academic Index (https://openalex.org)
# Provides premium rate limits for searching 250M+ scholarly works and papers.
OPENALEX_API_KEY=""

# CROSSREF_PLUS_TOKEN: Optional Crossref Plus API Token (https://www.crossref.org)
# Provides high-performance access to 150M+ DOIs and scholarly citations.
CROSSREF_PLUS_TOKEN=""

# GOOGLE_BOOKS_API_KEY: Optional API Key for Google Books API (https://developers.google.com/books)
# Increases rate limits for querying millions of digitized books, authors, and bibliographic metadata.
GOOGLE_BOOKS_API_KEY=""

# PERPLEXITY_API_KEY: Optional API Key for Perplexity AI models (sonar, sonar-reasoning)
PERPLEXITY_API_KEY=""
PERPLEXITY_BASE_URL="https://api.perplexity.ai"

# OPENAI_API_KEY: Optional API Key for OpenAI models (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# ANTHROPIC_API_KEY / CLAUDE_API_KEY: Optional API Key for Anthropic Claude models (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# Cloud SQL & PostgreSQL Database Environment Variables (automatically provided at runtime)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
